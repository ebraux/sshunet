{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Sea Surface Height Analysis with U-NET\n",
    "\n",
    "This notebook implements a lightweight U-NET model for SSH data analysis that can run without a GPU. We'll cover:\n",
    "1. Creating a synthetic SSH dataset\n",
    "2. Implementing the U-NET model with PyTorch Lightning\n",
    "3. Training the model\n",
    "4. Inference and visualization"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Setup and Package Installation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "# Install required packages if needed\n",
    "# !pip install torch torchvision pytorch-lightning matplotlib numpy pandas"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "import os\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from matplotlib.colors import LinearSegmentedColormap\n",
    "\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "import torch.nn.functional as F\n",
    "from torch.utils.data import Dataset, DataLoader\n",
    "\n",
    "import pytorch_lightning as pl\n",
    "from pytorch_lightning.callbacks import ModelCheckpoint, EarlyStopping\n",
    "\n",
    "# Set random seeds for reproducibility\n",
    "np.random.seed(42)\n",
    "torch.manual_seed(42)\n",
    "\n",
    "# Verify we're using CPU\n",
    "device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "print(f\"Using device: {device}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Create Synthetic Sea Surface Height Dataset"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "class LightSSHDataset(Dataset):\n",
    "    \"\"\"Dataset SSH léger pour tests sans GPU\"\"\"\n",
    "    def __init__(self, num_samples=100, size=64, mode='train'):\n",
    "        \"\"\"\n",
    "        Args:\n",
    "            num_samples: Nombre d'échantillons à générer\n",
    "            size: Taille des images (size x size)\n",
    "            mode: 'train' pour données d'entraînement, 'test' pour tester l'inférence\n",
    "        \"\"\"\n",
    "        self.size = size\n",
    "        self.num_samples = num_samples\n",
    "        self.mode = mode\n",
    "        self.data, self.ground_truth = self._generate_synthetic_data()\n",
    "        \n",
    "    def _generate_synthetic_data(self):\n",
    "        \"\"\"Génère des données SSH synthétiques avec bruits et signal\"\"\"\n",
    "        # Créer les tableaux vides\n",
    "        clean_data = np.zeros((self.num_samples, 1, self.size, self.size))\n",
    "        noisy_data = np.zeros((self.num_samples, 1, self.size, self.size))\n",
    "        \n",
    "        for i in range(self.num_samples):\n",
    "            # Créer une grille\n",
    "            x, y = np.meshgrid(np.linspace(0, 1, self.size), np.linspace(0, 1, self.size))\n",
    "            \n",
    "            # Générer le signal de base (océan calme)\n",
    "            base_level = 0.5 + 0.05 * np.random.rand()\n",
    "            wave = base_level + 0.1 * np.sin(10 * np.pi * x) + 0.1 * np.cos(8 * np.pi * y)\n",
    "            \n",
    "            # Ajouter des tourbillons (eddies)\n",
    "            num_eddies = np.random.randint(1, 4)\n",
    "            for _ in range(num_eddies):\n",
    "                cx, cy = np.random.rand(2)\n",
    "                radius = 0.1 + 0.1 * np.random.rand()\n",
    "                # Tourbillons soit positifs (anticycloniques) soit négatifs (cycloniques)\n",
    "                strength = 0.2 * np.random.rand() * (1 if np.random.rand() > 0.5 else -1)\n",
    "                dist = np.sqrt((x - cx)**2 + (y - cy)**2)\n",
    "                eddy = strength * np.exp(-(dist**2)/(2*radius**2))\n",
    "                wave += eddy\n",
    "            \n",
    "            # Ajouter des fronts océaniques\n",
    "            if np.random.rand() > 0.5:\n",
    "                angle = np.random.rand() * np.pi\n",
    "                pos = 0.2 + 0.6 * np.random.rand()\n",
    "                rotated_x = x * np.cos(angle) + y * np.sin(angle)\n",
    "                front = 0.1 * np.tanh((rotated_x - pos) * 10)\n",
    "                wave += front\n",
    "            \n",
    "            # Enregistrer les données propres\n",
    "            clean_data[i, 0] = wave\n",
    "            \n",
    "            # Ajouter du bruit pour les données d'entrée\n",
    "            noise_level = 0.02 + 0.02 * np.random.rand()\n",
    "            noise = noise_level * np.random.randn(self.size, self.size)\n",
    "            noisy_data[i, 0] = wave + noise\n",
    "        \n",
    "        return noisy_data, clean_data\n",
    "        \n",
    "    def __len__(self):\n",
    "        return self.num_samples\n",
    "    \n",
    "    def __getitem__(self, idx):\n",
    "        input_map = torch.tensor(self.data[idx], dtype=torch.float32)\n",
    "        target_map = torch.tensor(self.ground_truth[idx], dtype=torch.float32)\n",
    "        \n",
    "        if self.mode == 'train':\n",
    "            return {'input': input_map, 'target': target_map}\n",
    "        else:\n",
    "            # Pour l'inférence, on retourne aussi l'indice pour faciliter la visualisation\n",
    "            return {'input': input_map, 'target': target_map, 'idx': idx}"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### Visualiser les données synthétiques"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "def create_ssh_colormap():\n",
    "    \"\"\"Créer une colormap océanographique adaptée aux SSH\"\"\"\n",
    "    # Inspiré des colormaps utilisées en océanographie pour la SSH\n",
    "    colors = [(0, 0, 0.5),    # Bleu foncé pour les valeurs basses\n",
    "              (0, 0, 1),      # Bleu\n",
    "              (0, 0.8, 1),    # Bleu clair\n",
    "              (0.8, 1, 0.8),  # Vert clair\n",
    "              (1, 1, 0),      # Jaune\n",
    "              (1, 0.5, 0),    # Orange\n",
    "              (1, 0, 0),      # Rouge\n",
    "              (0.5, 0, 0)]    # Rouge foncé pour les valeurs hautes\n",
    "    \n",
    "    return LinearSegmentedColormap.from_list('ssh_cmap', colors, N=256)\n",
    "\n",
    "# Créer et visualiser quelques exemples\n",
    "test_dataset = LightSSHDataset(num_samples=5, size=64)\n",
    "ssh_cmap = create_ssh_colormap()\n",
    "\n",
    "fig, axes = plt.subplots(2, 5, figsize=(18, 6))\n",
    "\n",
    "for i in range(5):\n",
    "    sample = test_dataset[i]\n",
    "    \n",
    "    # Afficher l'entrée bruitée\n",
    "    im1 = axes[0, i].imshow(sample['input'][0], cmap=ssh_cmap)\n",
    "    axes[0, i].set_title(f\"Échantillon {i+1} (bruité)\")\n",
    "    axes[0, i].axis('off')\n",
    "    \n",
    "    # Afficher la vérité terrain\n",
    "    im2 = axes[1, i].imshow(sample['target'][0], cmap=ssh_cmap)\n",
    "    axes[1, i].set_title(f\"Échantillon {i+1} (propre)\")\n",
    "    axes[1, i].axis('off')\n",
    "\n",
    "plt.colorbar(im1, ax=axes.ravel().tolist(), shrink=0.7, label=\"SSH (m)\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Implement U-NET with PyTorch Lightning"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "class DoubleConv(nn.Module):\n",
    "    \"\"\"Double convolution block for U-NET\"\"\"\n",
    "    def __init__(self, in_channels, out_channels):\n",
    "        super().__init__()\n",
    "        self.double_conv = nn.Sequential(\n",
    "            nn.Conv2d(in_channels, out_channels, kernel_size=3, padding=1),\n",
    "            nn.BatchNorm2d(out_channels),\n",
    "            nn.ReLU(inplace=True),\n",
    "            nn.Conv2d(out_channels, out_channels, kernel_size=3, padding=1),\n",
    "            nn.BatchNorm2d(out_channels),\n",
    "            nn.ReLU(inplace=True)\n",
    "        )\n",
    "\n",
    "    def forward(self, x):\n",
    "        return self.double_conv(x)\n",
    "\n",
    "class Down(nn.Module):\n",
    "    \"\"\"Downscaling with maxpool then double conv\"\"\"\n",
    "    def __init__(self, in_channels, out_channels):\n",
    "        super().__init__()\n",
    "        self.maxpool_conv = nn.Sequential(\n",
    "            nn.MaxPool2d(2),\n",
    "            DoubleConv(in_channels, out_channels)\n",
    "        )\n",
    "\n",
    "    def forward(self, x):\n",
    "        return self.maxpool_conv(x)\n",
    "\n",
    "class Up(nn.Module):\n",
    "    \"\"\"Upscaling then double conv\"\"\"\n",
    "    def __init__(self, in_channels, out_channels, bilinear=True):\n",
    "        super().__init__()\n",
    "\n",
    "        # if bilinear, use the normal convolutions to reduce the number of channels\n",
    "        if bilinear:\n",
    "            self.up = nn.Upsample(scale_factor=2, mode='bilinear', align_corners=True)\n",
    "            self.conv = DoubleConv(in_channels, out_channels)\n",
    "        else:\n",
    "            self.up = nn.ConvTranspose2d(in_channels, in_channels // 2, kernel_size=2, stride=2)\n",
    "            self.conv = DoubleConv(in_channels, out_channels)\n",
    "\n",
    "    def forward(self, x1, x2):\n",
    "        x1 = self.up(x1)\n",
    "        # input is CHW\n",
    "        diff_y = x2.size()[2] - x1.size()[2]\n",
    "        diff_x = x2.size()[3] - x1.size()[3]\n",
    "\n",
    "        x1 = F.pad(x1, [diff_x // 2, diff_x - diff_x // 2,\n",
    "                        diff_y // 2, diff_y - diff_y // 2])\n",
    "        x = torch.cat([x2, x1], dim=1)\n",
    "        return self.conv(x)\n",
    "\n",
    "class OutConv(nn.Module):\n",
    "    def __init__(self, in_channels, out_channels):\n",
    "        super().__init__()\n",
    "        self.conv = nn.Conv2d(in_channels, out_channels, kernel_size=1)\n",
    "\n",
    "    def forward(self, x):\n",
    "        return self.conv(x)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "class LightUNet(nn.Module):\n",
    "    \"\"\"Version allégée du U-NET pour fonctionner sur CPU\"\"\"\n",
    "    def __init__(self, n_channels, n_classes, bilinear=True):\n",
    "        super().__init__()\n",
    "        self.n_channels = n_channels\n",
    "        self.n_classes = n_classes\n",
    "        self.bilinear = bilinear\n",
    "\n",
    "        # Réduire le nombre de filtres comparé au U-NET standard\n",
    "        self.inc = DoubleConv(n_channels, 32)\n",
    "        self.down1 = Down(32, 64)\n",
    "        self.down2 = Down(64, 128)\n",
    "        self.down3 = Down(128, 256)\n",
    "        factor = 2 if bilinear else 1\n",
    "        self.down4 = Down(256, 512 // factor)\n",
    "        self.up1 = Up(512, 256 // factor, bilinear)\n",
    "        self.up2 = Up(256, 128 // factor, bilinear)\n",
    "        self.up3 = Up(128, 64 // factor, bilinear)\n",
    "        self.up4 = Up(64, 32, bilinear)\n",
    "        self.outc = OutConv(32, n_classes)\n",
    "\n",
    "    def forward(self, x):\n",
    "        x1 = self.inc(x)\n",
    "        x2 = self.down1(x1)\n",
    "        x3 = self.down2(x2)\n",
    "        x4 = self.down3(x3)\n",
    "        x5 = self.down4(x4)\n",
    "        x = self.up1(x5, x4)\n",
    "        x = self.up2(x, x3)\n",
    "        x = self.up3(x, x2)\n",
    "        x = self.up4(x, x1)\n",
    "        logits = self.outc(x)\n",
    "        return logits"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "class SSHLightningModel(pl.LightningModule):\n",
    "    def __init__(self, input_channels=1, output_channels=1, learning_rate=1e-3):\n",
    "        super().__init__()\n",
    "        self.save_hyperparameters()\n",
    "        self.model = LightUNet(n_channels=input_channels, n_classes=output_channels)\n",
    "        self.learning_rate = learning_rate\n",
    "        \n",
    "        # MSE loss pour la régression des valeurs SSH\n",
    "        self.loss_fn = nn.MSELoss()\n",
    "        \n",
    "    def forward(self, x):\n",
    "        return self.model(x)\n",
    "    \n",
    "    def training_step(self, batch, batch_idx):\n",
    "        x = batch['input']\n",
    "        y = batch['target']\n",
    "        y_hat = self(x)\n",
    "        loss = self.loss_fn(y_hat, y)\n",
    "        self.log('train_loss', loss, on_step=True, on_epoch=True, prog_bar=True)\n",
    "        return loss\n",
    "    \n",
    "    def validation_step(self, batch, batch_idx):\n",
    "        x = batch['input']\n",
    "        y = batch['target']\n",
    "        y_hat = self(x)\n",
    "        val_loss = self.loss_fn(y_hat, y)\n",
    "        self.log('val_loss', val_loss, on_epoch=True, prog_bar=True)\n",
    "        \n",
    "        # Calculer et logger le PSNR (Peak Signal to Noise Ratio)\n",
    "        with torch.no_grad():\n",
    "            mse = F.mse_loss(y_hat, y)\n",
    "            max_val = torch.max(y)\n",
    "            psnr = 20 * torch.log10(max_val / torch.sqrt(mse))\n",
    "            self.log('val_psnr', psnr, on_epoch=True, prog_bar=True)\n",
    "        \n",
    "    def configure_optimizers(self):\n",
    "        optimizer = torch.optim.Adam(self.parameters(), lr=self.learning_rate)\n",
    "        scheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(\n",
    "            optimizer, mode='min', factor=0.5, patience=3, verbose=True\n",
    "        )\n",
    "        return {\n",
    "            \"optimizer\": optimizer,\n",
    "            \"lr_scheduler\": {\n",
    "                \"scheduler\": scheduler,\n",
    "                \"monitor\": \"val_loss\",\n",
    "            },\n",
    "        }"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Training the Model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "# Préparer les datasets et dataloaders\n",
    "train_size = 48\n",
    "val_size = 16\n",
    "test_size = 8\n",
    "\n",
    "train_dataset = LightSSHDataset(num_samples=train_size, size=64, mode='train')\n",
    "val_dataset = LightSSHDataset(num_samples=val_size, size=64, mode='train')\n",
    "test_dataset = LightSSHDataset(num_samples=test_size, size=64, mode='test')\n",
    "\n",
    "train_loader = DataLoader(train_dataset, batch_size=4, shuffle=True, num_workers=0)\n",
    "val_loader = DataLoader(val_dataset, batch_size=4, num_workers=0)\n",
    "test_loader = DataLoader(test_dataset, batch_size=1, num_workers=0)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "# Créer et configurer le modèle\n",
    "model = SSHLightningModel(input_channels=1, output_channels=1, learning_rate=1e-3)\n",
    "\n",
    "# Définir les callbacks pour l'entraînement\n",
    "checkpoint_callback = ModelCheckpoint(\n",
    "    dirpath='checkpoints',\n",
    "    filename='ssh-unet-{epoch:02d}-{val_loss:.4f}',\n",
    "    monitor='val_loss',\n",
    "    mode='min',\n",
    "    save_top_k=1\n",
    ")\n",
    "\n",
    "early_stop_callback = EarlyStopping(\n",
    "    monitor='val_loss',\n",
    "    patience=5,\n",
    "    mode='min',\n",
    "    verbose=True\n",
    ")\n",
    "\n",
    "# Créer le trainer\n",
    "trainer = pl.Trainer(\n",
    "    max_epochs=20,  # Peut être réduit pour des tests rapides\n",
    "    accelerator='cpu',\n",
    "    devices=1,\n",
    "    callbacks=[checkpoint_callback, early_stop_callback],\n",
    "    log_every_n_steps=5,\n",
    "    # Limite optionnelle pour des tests rapides\n",
    "    # limit_train_batches=10,\n",
    "    # limit_val_batches=5\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "# Entraîner le modèle\n",
    "trainer.fit(model, train_loader, val_loader)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Inference and Visualization"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "# Charger le meilleur modèle\n",
    "best_model_path = checkpoint_callback.best_model_path\n",
    "if os.path.exists(best_model_path):\n",
    "    model = SSHLightningModel.load_from_checkpoint(best_model_path)\n",
    "    print(f\"Loaded model from {best_model_path}\")\n",
    "else:\n",
    "    print(\"No checkpoint found, using the last trained model\")\n",
    "\n",
    "model.eval();"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "def visualize_predictions(model, dataloader, num_samples=4, cmap=None):\n",
    "    \"\"\"Visualiser les prédictions du modèle\"\"\"\n",
    "    if cmap is None:\n",
    "        cmap = create_ssh_colormap()\n",
    "    \n",
    "    model.eval()\n",
    "    with torch.no_grad():\n",
    "        fig, axes = plt.subplots(3, num_samples, figsize=(18, 9))\n",
    "        metrics = []\n",
    "        \n",
    "        for i, batch in enumerate(dataloader):\n",
    "            if i >= num_samples:\n",
    "                break\n",
    "                \n",
    "            x = batch['input']\n",
    "            y_true = batch['target']\n",
    "            \n",
    "            # Prédiction\n",
    "            y_pred = model(x)\n",
    "            \n",
    "            # Calculer des métriques\n",
    "            mse = F.mse_loss(y_pred, y_true).item()\n",
    "            max_val = torch.max(y_true).item()\n",
    "            psnr = 20 * np.log10(max_val / np.sqrt(mse))\n",
    "            \n",
    "            metrics.append({\n",
    "                'mse': mse,\n",
    "                'psnr': psnr,\n",
    "            })\n",
    "            \n",
    "            # Convertir en numpy pour affichage\n",
    "            input_img = x.squeeze().numpy()\n",
    "            true_img = y_true.squeeze().numpy()\n",
    "            pred_img = y_pred.squeeze().numpy()\n",
    "            \n",
    "            # Afficher les images\n",
    "            ax1 = axes[0, i]\n",
    "            im1 = ax1.imshow(input_img, cmap=cmap)\n",
    "            ax1.set_title(f\"Input (bruitée)\")\n",
    "            ax1.axis('off')\n",
    "            \n",
    "            ax2 = axes[1, i]\n",
    "            im2 = ax2.imshow(pred_img, cmap=cmap)\n",
    "            ax2.set_title(f\"Prédiction\\nPSNR: {psnr:.2f}dB\")\n",
    "            ax2.axis('off')\n",
    "            \n",
    "            ax3 = axes[2, i]\n",
    "            im3 = ax3.imshow(true_img, cmap=cmap)\n",
    "            ax3.set_title(f\"Référence\")\n",
    "            ax3.axis('off')\n",
    "        \n",
    "        plt.colorbar(im1, ax=axes.ravel().tolist(), shrink=0.7, label=\"SSH (m)\")\n",
    "        plt.tight_layout()\n",
    "        plt.show()\n",
    "        \n",
    "        # Afficher les métriques moyennes\n",
    "        avg_mse = sum(item['mse'] for item in metrics) / len(metrics)\n",
    "        avg_psnr = sum(item['psnr'] for item in metrics) / len(metrics)\n",
    "        print(f\"Métriques moyennes sur {len(metrics)} échantillons:\")\n",
    "        print(f\"  MSE: {avg_mse:.6f}\")\n",
    "        print(f\"  PSNR: {avg_psnr:.2f}dB\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "# Visualiser les prédictions sur le jeu de test\n",
    "visualize_predictions(model, test_loader)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Analyse des Anomalies de SSH"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "source": [
    "def detect_and_visualize_anomalies(model, dataloader, threshold=0.05, num_samples=3):\n",
    "    \"\"\"Détecter et visualiser les anomalies de SSH\"\"\"\n",
    "    model.eval()\n",
    "    cmap = create_ssh_colormap()\n",
    "    \n",
    "    with torch.no_grad():\n",
    "        for i, batch in enumerate(dataloader):\n",
    "            if i >= num_samples:\n",
    "                break\n",
    "                \n",
    "            x = batch['input']\n",
    "            y_true = batch['target']\n",
    "            \n",
    "            # Prédiction\n",
    "            y_pred = model(x)\n",
    "            \n",
    "            # Calculer l'erreur absolue\n",
    "            error = torch.abs(y_pred - y_true)\n",
    "            \n",
    "            # Masque des anomalies (erreur > threshold)\n",
    "            anomaly_mask = (error > threshold).float().squeeze().numpy()\n",
    "            \n",
    "            # Convertir en numpy pour affichage\n",
    "            input_img = x.squeeze().numpy()\n",
    "            true_img = y_true.squeeze().numpy()\n",
    "            pred_img = y_pred.squeeze().numpy()\n",
    "            error_img = error.squeeze().numpy()\n",
    "            \n",
    "            # Visualisation\n",
    "            fig, axes = plt.subplots(2, 2, figsize=(12, 10))\n",
    "            \n",
    "            # Afficher la prédiction\n",
    "            im1 = axes[0, 0